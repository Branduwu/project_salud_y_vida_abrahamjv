# Desarrollo local: PostgreSQL Docker. Nunca publiques un archivo .env real.
DATABASE_URL="postgres://USER:PASSWORD@localhost:5433/saludyvida_dev"

# Requerido para crear/verificar sesiones server-side; genera al menos 32 bytes aleatorios.
AUTH_SECRET="replace-with-a-random-32-byte-secret"

# Sólo para ejecutar suites E2E contra una base aislada; nunca configurar en producción.
TEST_DATABASE_URL="postgres://USER:PASSWORD@localhost:5433/saludyvida_test"
